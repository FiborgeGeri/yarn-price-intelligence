            netWeight: item.netWeight || null, lotNo: item.lotNo || null,
          });
        }
      }
    }

    return NextResponse.json({ success: true, id: gr.id, grNo, dnNo });
  } catch (err) {
    console.error("GR POST error:", err);
    return NextResponse.json({ error: "Failed" }, { status: 500 });
  }
}

