INSERT INTO customer_contacts (customer_id, contact_name, email, phone, position)
SELECT c.id, v.name, v.email, v.phone, v.position
FROM (VALUES
  ('Aurora Knits',  'Vivian Lau',   'vivian@auroraknits.hk',  '+852 9123 4400', 'Senior Merchandiser'),
